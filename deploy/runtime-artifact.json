{
  "version": 1,
  "artifactRoot": ".next/standalone",
  "manifest": "runtime-manifest.json",
  "entrypoints": ["runtime-scripts/start-production.mjs", "server.js"],
  "requiredFiles": [
    ".node-version",
    ".nvmrc",
    ".next/BUILD_ID",
    ".next/required-server-files.json",
    ".next/server/app/api/collection-permit/route.js",
    ".next/server/app/api/revenue/movements/route.js",
    ".next/server/app/healthz/route.js",
    ".next/server/app/readyz/route.js",
    ".next/server/app/verified-tracker-script/route.js",
    "db/clickhouse/migrations/15_expire_new_heatmap_events.sql",
    "db/clickhouse/migrations/16_expire_new_session_replays.sql",
    "db/clickhouse/migrations/17_add_session_data_trust_tier.sql",
    "db/clickhouse/migrations/18_disable_unverified_revenue_materialization.sql",
    "db/clickhouse/migrations/19_add_event_collection_trust_tier.sql",
    "db/clickhouse/migrations/20_add_verified_event_data_pivot.sql",
    "generated/prisma/client.js",
    "geo/GeoLite2-City.mmdb",
    "migration-tool/node_modules/prisma",
    "migration-tool/package.json",
    "migration-tool/pnpm-lock.yaml",
    "migration-tool/prisma.config.ts",
    "node_modules/@prisma/client",
    "node_modules/lightningcss",
    "node_modules/lightningcss-linux-arm64-gnu/lightningcss.linux-arm64-gnu.node",
    "node_modules/next",
    "node_modules/pg",
    "package.json",
    "pnpm-lock.yaml",
    "prisma/migration-ledger-contract.json",
    "prisma/migrations/26_add_api_key/migration.sql",
    "prisma/migrations/30_revoke_sessions_on_factor_reset/migration.sql",
    "prisma/migrations/31_bound_event_ingestion/migration.sql",
    "prisma/migrations/32_expire_replay_visit_budgets/migration.sql",
    "prisma/migrations/33_expire_new_heatmap_events/migration.sql",
    "prisma/migrations/34_expire_api_keys/migration.sql",
    "prisma/migrations/35_expire_new_session_replays/migration.sql",
    "prisma/migrations/36_add_session_data_trust_tier/migration.sql",
    "prisma/migrations/37_add_event_collection_trust_tier/migration.sql",
    "prisma/migrations/38_add_session_link_trust_tier/migration.sql",
    "prisma/migrations/39_bind_collection_keys_to_website_owner/migration.sql",
    "prisma/migrations/40_add_attested_revenue_movement/migration.sql",
    "prisma/migrations/migration_lock.toml",
    "prisma/schema.prisma",
    "public/openapi.json",
    "public/recorder.js",
    "public/script.js",
    "runtime-scripts/artifact-smoke.mjs",
    "runtime-scripts/check-db.mjs",
    "runtime-scripts/check-env.mjs",
    "runtime-scripts/prune-expired-heatmap-events.mjs",
    "runtime-scripts/prune-expired-session-replays.mjs",
    "runtime-scripts/start-production.mjs",
    "server.js"
  ],
  "requiredDirectories": [".next/cache"],
  "requiredPatterns": [
    {
      "pattern": "prisma/migrations/*/migration.sql",
      "minimum": 26
    },
    {
      "pattern": "migration-tool/node_modules/.pnpm/@prisma+engines@*/node_modules/@prisma/engines/schema-engine-linux-arm64-openssl-3.0.x",
      "minimum": 1
    },
    {
      "pattern": "migration-tool/node_modules/.pnpm/@prisma+engines@*/node_modules/@prisma/engines/package.json",
      "minimum": 1
    },
    {
      "pattern": "migration-tool/node_modules/.pnpm/prisma@*/node_modules/prisma/build/index.js",
      "minimum": 1
    },
    {
      "pattern": "migration-tool/node_modules/.pnpm/prisma@*/node_modules/prisma/package.json",
      "minimum": 1
    },
    {
      "pattern": "node_modules/.pnpm/@prisma+client@*/node_modules/@prisma/client/package.json",
      "minimum": 1
    },
    {
      "pattern": "node_modules/.pnpm/next@*/node_modules/next/package.json",
      "minimum": 1
    },
    {
      "pattern": "node_modules/.pnpm/pg@*/node_modules/pg/package.json",
      "minimum": 1
    },
    {
      "pattern": "node_modules/.pnpm/lightningcss@*/node_modules/lightningcss-linux-arm64-gnu",
      "minimum": 1
    },
    {
      "pattern": "node_modules/.pnpm/@img+sharp-linux-arm64@*/node_modules/@img/sharp-linux-arm64/lib/*.node",
      "minimum": 1
    },
    {
      "pattern": "node_modules/.pnpm/@img+sharp-libvips-linux-arm64@*/node_modules/@img/sharp-libvips-linux-arm64/lib/*.so.*",
      "minimum": 1
    }
  ],
  "allowedRoots": [
    ".next",
    "db",
    "generated",
    "geo",
    "migration-tool",
    "node_modules",
    "packages",
    "prisma",
    "public",
    "runtime-scripts"
  ],
  "allowedFiles": [
    ".node-version",
    ".nvmrc",
    "package.json",
    "pnpm-lock.yaml",
    "prisma.config.ts",
    "server.js"
  ],
  "forbiddenStateTrees": [".data", ".next/cache", "cache", "data", "logs", "spool", "uploads"],
  "runtime": {
    "os": "linux",
    "arch": "arm64",
    "libc": "glibc",
    "node": "24.18.1",
    "packageManager": "pnpm@11.18.0"
  },
  "deployment": {
    "schemaVersion": 4,
    "applicationId": "analytics-umami-template",
    "requiredAdapterCapabilities": [
      "artifact-only-promotion-v1",
      "verified-source-and-payload-v1",
      "guarded-forward-migrations-v1",
      "packaged-migration-tool-v1",
      "retained-artifact-rollback-v1",
      "database-aware-recovery-v1",
      "legacy-clickhouse-erasure-review-v1",
      "bounded-heatmap-retention-v1",
      "bounded-replay-retention-v1",
      "authenticated-advanced-collection-v1",
      "owner-bound-collection-keys-v1",
      "session-property-trust-tier-v1",
      "identity-link-trust-tier-v1",
      "event-claim-trust-tier-v1",
      "unverified-revenue-materialization-disabled-v1",
      "attested-revenue-ledger-v1",
      "version-aware-readiness-v1"
    ],
    "probes": {
      "health": { "path": "/healthz", "methods": ["GET", "HEAD"], "success": 200 },
      "readiness": { "path": "/readyz", "methods": ["GET", "HEAD"], "success": 200, "failure": 503 }
    },
    "database": {
      "prePromotionGate": "runtime-scripts/check-db.mjs",
      "migrationMode": "forward-only",
      "rollback": "protected-pre-traffic-database-restore-v1"
    },
    "hostControlled": [
      "service-user",
      "listener",
      "reverse-proxy",
      "protected-environment",
      "database"
    ]
  },
  "modulesOutsideBuildDirectories": [
    "db/clickhouse/migrations/15_expire_new_heatmap_events.sql",
    "db/clickhouse/migrations/16_expire_new_session_replays.sql",
    "db/clickhouse/migrations/17_add_session_data_trust_tier.sql",
    "db/clickhouse/migrations/18_disable_unverified_revenue_materialization.sql",
    "db/clickhouse/migrations/19_add_event_collection_trust_tier.sql",
    "db/clickhouse/migrations/20_add_verified_event_data_pivot.sql",
    "generated/prisma",
    "geo",
    "migration-tool",
    "prisma/migrations",
    "runtime-scripts/prune-expired-heatmap-events.mjs",
    "runtime-scripts/prune-expired-session-replays.mjs",
    "runtime-scripts"
  ],
  "productionDependencies": [
    "migration-tool/node_modules/.pnpm/@prisma+engines@*/node_modules/@prisma/engines",
    "migration-tool/node_modules/prisma",
    "node_modules/@prisma/client",
    "node_modules/lightningcss",
    "node_modules/next",
    "node_modules/pg"
  ],
  "generatedClients": ["generated/prisma"],
  "nativeBindings": [
    "migration-tool/node_modules/.pnpm/@prisma+engines@*/node_modules/@prisma/engines/schema-engine-linux-arm64-openssl-3.0.x",
    "node_modules/lightningcss-linux-arm64-gnu/lightningcss.linux-arm64-gnu.node",
    "node_modules/.pnpm/@img+sharp-linux-arm64@*/node_modules/@img/sharp-linux-arm64/lib/*.node",
    "node_modules/.pnpm/@img+sharp-libvips-linux-arm64@*/node_modules/@img/sharp-libvips-linux-arm64/lib/*.so.*"
  ],
  "staticAssets": [".next/static", "geo", "public"],
  "writableState": [
    {
      "name": "Next runtime cache",
      "location": ".next/cache inside each immutable release",
      "promotion": "Start empty; never copy from the active release.",
      "rollback": "Retained releases may reuse only their own disposable cache; deleting it is safe."
    },
    {
      "name": "PostgreSQL data",
      "location": "Host-managed external database",
      "promotion": "Quiesce all writers, back up and rehearse migrations and retained-runtime recovery before activation.",
      "rollback": "Restore the verified pre-migration backup only before public writes resume; after traffic resumes, use a compatible forward repair. Never restore from an application artifact."
    },
    {
      "name": "Redis and ClickHouse data",
      "location": "Optional external services",
      "promotion": "Preserve outside releases and require readiness when configured.",
      "rollback": "Never package or overwrite external service state."
    },
    {
      "name": "Temporary files and logs",
      "location": "PrivateTmp and the system journal",
      "promotion": "Disposable temporary files; logs remain service-managed.",
      "rollback": "Never copy temporary files or logs into a release."
    }
  ],
  "privateConfiguration": "Protected environment files, credentials, database contents, uploads, queues, logs, and cache contents remain outside the artifact.",
  "topology": "One loopback-only Node service per analytics instance behind the existing Nginx IPv4 and IPv6 listeners. Preserve instance ports, users, environment files, databases, certificates, and DNS."
}
