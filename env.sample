# Install the production copy as /etc/umami/<instance>.env with mode 0600.
# Never commit a populated environment file. Production startup rejects missing
# or placeholder secrets, non-loopback listeners, ambiguous proxy trust, and
# insecure connections to public database/cache hosts.

# Required in production. Generate APP_SECRET and INTERNAL_DIAGNOSTICS_KEY with:
#   openssl rand -hex 32
# CLIENT_IP_HEADER must be overwritten by your trusted edge/reverse proxy on
# every request (for example, x-real-ip in a correctly configured Nginx proxy).
DATABASE_URL=
DATABASE_TYPE=postgresql
APP_SECRET=
PUBLIC_URL=
CLIENT_IP_HEADER=
INTERNAL_DIAGNOSTICS_KEY=
UMAMI_BIND_ADDRESS=127.0.0.1
PORT=3000

# Use PostgreSQL 15 or newer from the operating system or a managed service.
# Keep its credentials in DATABASE_URL and URL-encode reserved password
# characters. Use at least 16 random UTF-8 bytes for the database password.

# Hardened defaults. Location headers remain untrusted unless your edge
# overwrites them. Client-info payload trust is for the Umami cloud collector
# architecture only and requires a separate key on every trusted request.
DISABLE_TELEMETRY=1
DISABLE_PUBLIC_SHARES=1
ENABLE_UPDATE_CHECKS=0
ENABLE_TEST_CONSOLE=0
FORCE_SSL=1
LOG_QUERY=0
SKIP_DB_CHECK=0
SKIP_DB_MIGRATION=0
TRUST_CLIENT_INFO_PAYLOAD=0
CLIENT_INFO_TRUST_KEY=
TRUST_LOCATION_HEADERS=0
SKIP_LOCATION_HEADERS=0

# Optional security and capacity controls (shown with application defaults).
AUTH_SESSION_TTL_SECONDS=28800
CACHE_TOKEN_TTL_SECONDS=86400
SHARE_TOKEN_TTL_SECONDS=3600
MAX_API_BODY_BYTES=1048576
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT_FAILURES=10
LOGIN_RATE_LIMIT_IP_FAILURES=50
COLLECTION_RATE_LIMIT_WINDOW_SECONDS=60
COLLECTION_RATE_LIMIT_PER_IP=1200
COLLECTION_RATE_LIMIT_PER_SOURCE=50000
SALT_ROTATION=month

# Optional services. Public hosts must use encrypted protocols.
# DIRECT_DATABASE_URL=
# DATABASE_REPLICA_URL=
# REDIS_URL=
# CLICKHOUSE_URL=
# KAFKA_URL=
# KAFKA_BROKER=
# KAFKA_SSL=1
# KAFKA_SASL_MECHANISM=scram-sha-512

# Optional UI/build configuration.
# ALLOWED_FRAME_URLS=
# API_URL=
# BASE_PATH=
# COLLECT_API_ENDPOINT=
# FAVICON_URL=
# LINKS_URL=
# PIXELS_URL=
# TRACKER_SCRIPT_NAME=
# TRACKER_SCRIPT_URL=
# UMAMI_SELF_TRACK=
# UMAMI_SELF_RECORD=

# Cypress integration tests read these from ../.env.
CYPRESS_umami_user=admin
CYPRESS_umami_password=
