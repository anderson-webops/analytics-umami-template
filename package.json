{
  "name": "umami",
  "version": "3.2.4",
  "private": true,
  "description": "A modern, privacy-focused alternative to Google Analytics.",
  "author": "Umami Software, Inc. <hello@umami.is>",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=11.18.0 <12"
  },
  "license": "MIT",
  "homepage": "https://github.com/anderson-webops/analytics-umami-template",
  "repository": {
    "type": "git",
    "url": "https://github.com/anderson-webops/analytics-umami-template.git"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm run check-env",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 dotenv next dev --turbo",
    "build": "npm-run-all check-env build-db check-db build-tracker build-recorder build-geo build-app",
    "prestart": "npm-run-all check-env check-db",
    "start": "next start",
    "build-docker": "npm-run-all build-db build-tracker build-recorder build-geo build-app postbuild",
    "start-docker": "npm-run-all check-env check-db update-tracker start-server",
    "start-env": "node scripts/start-env.js",
    "start-server": "node server.js",
    "build-app": "cross-env NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "build-icons": "svgr ./src/assets --out-dir src/components/svg --typescript",
    "build-components": "node scripts/bump-components.js && tsup",
    "build-tracker": "rollup -c rollup.tracker.config.js",
    "build-recorder": "rollup -c rollup.recorder.config.js",
    "build-prisma-client": "node scripts/build-prisma-client.js",
    "build-lang": "npm-run-all download-country-names download-language-names",
    "build-geo": "node scripts/build-geo.js",
    "build-db": "npm-run-all build-db-client build-prisma-client",
    "build-db-schema": "prisma db pull",
    "build-db-client": "prisma generate",
    "update-tracker": "node scripts/update-tracker.js",
    "update-db": "prisma migrate deploy",
    "check-db": "node scripts/check-db.js",
    "check-env": "node scripts/check-env.js",
    "check-missing-messages": "node scripts/check-missing-messages.js",
    "check:native-bindings": "node scripts/check-native-bindings.js",
    "check:peers": "pnpm peers check",
    "copy-db-files": "node scripts/copy-db-files.js",
    "download-country-names": "node scripts/download-country-names.js",
    "download-language-names": "node scripts/download-language-names.js",
    "change-password": "node scripts/change-password.js",
    "postbuild": "node scripts/postbuild.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed-data": "tsx scripts/seed-data.ts",
    "lint": "biome lint .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "audit:all": "pnpm audit --audit-level high",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "prevalidate": "pnpm run build-db",
    "validate": "npm-run-all check:native-bindings check:peers format:check typecheck test:unit",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "cacheDirectories": [
    ".next/cache"
  ],
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@date-fns/utc": "^2.1.1",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@tanstack/react-query": "^5.101.4",
    "@umami/react-zen": "^0.245.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "classnames": "^2.5.1",
    "colord": "^2.9.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "debug": "^4.4.3",
    "detect-browser": "^5.3.0",
    "dotenv": "^17.4.2",
    "immer": "^11.1.15",
    "ipaddr.js": "^2.4.0",
    "is-localhost-ip": "^3.0.1",
    "isbot": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.27.0",
    "maxmind": "^5.0.6",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "npm-run-all2": "^9.0.3",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-resizable-panels": "^4.12.2",
    "react-simple-maps": "^3.0.0",
    "react-use-measure": "^2.1.7",
    "react-window": "^2.3.0",
    "redis": "^6.1.0",
    "request-ip": "^3.3.0",
    "rrweb": "^2.1.1",
    "rrweb-player": "2.1.1",
    "semver": "^7.8.5",
    "server-only": "0.0.1",
    "serialize-error": "^13.0.1",
    "thenby": "^1.4.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.62.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@svgr/cli": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "0.28.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "postcss": "8.5.25",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "11.3.2",
    "prompts": "2.4.2",
    "rollup": "^4.62.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-node-externals": "^9.0.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tar": "7.5.22",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
