{
  "name": "umami",
  "version": "4.2.6",
  "private": true,
  "description": "A modern, privacy-focused alternative to Google Analytics.",
  "author": "Umami Software, Inc. <hello@umami.is>",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=11.18.0 <12"
  },
  "license": "MIT",
  "homepage": "https://github.com/anderson-webops/analytics-umami-template",
  "repository": {
    "type": "git",
    "url": "https://github.com/anderson-webops/analytics-umami-template.git"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm run check:env",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 dotenv next dev --turbo --hostname 127.0.0.1",
    "build": "npm-run-all check:env build:db check:db build:tracker build:recorder build:geo build:openapi build:packages build:app",
    "prestart": "npm-run-all check:env check:db",
    "start": "next start",
    "build:production": "npm-run-all build:db build:tracker build:recorder build:geo build:openapi build:packages build:app postbuild",
    "start:production": "node scripts/start-production.js",
    "start:env": "node scripts/start-env.js",
    "start:server": "node server.js",
    "build:app": "cross-env NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "build:icons": "svgr ./src/assets --out-dir src/components/svg --typescript",
    "build:components": "node scripts/bump-components.js && tsup",
    "build:tracker": "npm-run-all check:tracker build:tracker:script build:tracker:types",
    "build:tracker:script": "rollup -c rollup.tracker.config.js",
    "build:tracker:types": "tsc -p tsconfig.tracker.types.json && biome format --write src/tracker/index.d.ts",
    "check:tracker": "tsc -p tsconfig.tracker.json --noEmit",
    "build:recorder": "rollup -c rollup.recorder.config.js",
    "build:prisma:client": "node scripts/build-prisma-client.js",
    "build:languages": "npm-run-all download:countries download:languages",
    "build:geo": "node scripts/build-geo.js",
    "build:openapi": "npm-run-all openapi:generate generate:api:client",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build:db": "npm-run-all generate:db:client build:prisma:client",
    "db:pull": "prisma db pull",
    "generate:db:client": "prisma generate",
    "update:tracker": "node scripts/update-tracker.js",
    "db:migrate": "node scripts/check-db.js --migrate-only",
    "check:db": "node scripts/check-db.js",
    "check:env": "node scripts/check-env.js",
    "check:migration-history": "node scripts/migration-ledger-contract.mjs",
    "check:messages": "node scripts/check-missing-messages.js",
    "check:native-bindings": "node scripts/check-native-bindings.js",
    "check:peers": "pnpm peers check",
    "copy-db-files": "node scripts/copy-db-files.js",
    "download:countries": "node scripts/download-country-names.js",
    "download:languages": "node scripts/download-language-names.js",
    "change-password": "node scripts/change-password.js",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:contracts": "tsx scripts/generate-openapi-contracts.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "generate:api": "npm-run-all openapi:generate generate:api:client",
    "generate:api:client": "tsx scripts/generate-api-client.ts",
    "check:api:client": "tsx scripts/generate-api-client.ts --check",
    "postbuild": "node scripts/postbuild.js",
    "runtime:manifest": "node scripts/runtime-artifact.mjs create .next/standalone",
    "runtime:verify": "node scripts/runtime-artifact.mjs verify .next/standalone",
    "test:runtime-artifact": "node --test scripts/test-runtime-artifact-manifest.mjs && node scripts/test-runtime-artifact.mjs",
    "test:migration-bridge": "node scripts/test-session-data-migration-bridge.js",
    "test:migration-history": "node --test scripts/test-migration-ledger-contract.mjs",
    "pretest": "pnpm generate:db:client",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:packages": "pnpm --filter \"./packages/**\" -r test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "tsx scripts/test-api.ts",
    "test:api:clickhouse": "tsx scripts/test-api.ts --clickhouse",
    "test:api:run": "playwright test -c playwright.api.config.ts",
    "test:api:up": "tsx scripts/test-api.ts --up-only",
    "test:api:down": "tsx scripts/test-api.ts --down",
    "test:api:coverage": "tsx scripts/test-api.ts --coverage-report",
    "db:seed": "tsx scripts/seed-data.ts",
    "start-env": "pnpm run start:env",
    "start-server": "pnpm run start:server",
    "build-app": "pnpm run build:app",
    "build-icons": "pnpm run build:icons",
    "build-components": "pnpm run build:components",
    "build-tracker": "pnpm run build:tracker",
    "build-recorder": "pnpm run build:recorder",
    "build-prisma-client": "pnpm run build:prisma:client",
    "build-lang": "pnpm run build:languages",
    "build-geo": "pnpm run build:geo",
    "build-db": "pnpm run build:db",
    "build-db-schema": "pnpm run db:pull",
    "build-db-client": "pnpm run generate:db:client",
    "update-tracker": "pnpm run update:tracker",
    "update-db": "pnpm run db:migrate",
    "check-db": "pnpm run check:db",
    "check-env": "pnpm run check:env",
    "check-missing-messages": "pnpm run check:messages",
    "download-country-names": "pnpm run download:countries",
    "download-language-names": "pnpm run download:languages",
    "seed-data": "pnpm run db:seed",
    "lint": "biome lint .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "audit:all": "pnpm audit --audit-level high",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "prevalidate": "npm-run-all build:db build:packages",
    "validate": "npm-run-all check:migration-history test:migration-history check:native-bindings check:peers format:check typecheck test:unit",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "cacheDirectories": [
    ".next/cache"
  ],
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@date-fns/utc": "^2.1.1",
    "@dicebear/collection": "^9.4.3",
    "@dicebear/core": "^9.4.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@tanstack/react-query": "^5.103.1",
    "@umami/api-client": "workspace:*",
    "@umami/mcp": "workspace:*",
    "@umami/react-zen": "^0.255.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "classnames": "^2.5.1",
    "colord": "^2.10.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "debug": "^4.4.3",
    "detect-browser": "^5.3.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "immer": "^11.1.18",
    "ipaddr.js": "^2.5.0",
    "is-localhost-ip": "^3.0.1",
    "isbot": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.47.0",
    "maxmind": "^5.0.7",
    "motion": "^12.43.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "npm-run-all2": "^9.0.3",
    "otplib": "^13.5.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-resizable-panels": "^4.12.4",
    "react-simple-maps": "^3.0.0",
    "react-use-measure": "^2.1.7",
    "react-window": "^2.3.1",
    "redis": "^6.2.0",
    "request-ip": "^3.3.0",
    "rrweb": "^2.1.1",
    "rrweb-player": "2.1.6",
    "semver": "^7.8.5",
    "server-only": "0.0.1",
    "thenby": "^1.4.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@netlify/plugin-nextjs": "^5.16.0",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@svgr/cli": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "11.5.3",
    "prompts": "2.4.2",
    "rollup": "^4.63.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-node-externals": "^9.0.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tar": "7.5.22",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod-openapi": "^6.0.2"
  }
}
