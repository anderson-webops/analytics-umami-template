{
  "name": "umami",
  "version": "4.2.188",
  "private": true,
  "description": "A modern, privacy-focused alternative to Google Analytics.",
  "author": "Umami Software, Inc. <hello@umami.is>",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "license": "MIT",
  "homepage": "https://github.com/anderson-webops/analytics-umami-template",
  "repository": {
    "type": "git",
    "url": "https://github.com/anderson-webops/analytics-umami-template.git"
  },
  "type": "module",
  "scripts": {
    "predev": "pnpm run check:env",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 node --import dotenv/config node_modules/next/dist/bin/next dev --turbo --hostname 127.0.0.1",
    "build": "npm-run-all check:collect-build-config check:env build:db check:db:build build:tracker build:recorder build:geo build:openapi build:packages build:app",
    "start": "node scripts/start-production.js",
    "build:production": "cross-env GEO_BUILD_REQUIRED=1 npm-run-all check:collect-build-config build:db build:tracker build:recorder build:geo build:openapi build:packages build:app postbuild",
    "check:collect-build-config": "node scripts/check-collect-build-config.mjs",
    "start:production": "node scripts/start-production.js",
    "start:env": "node scripts/start-env.js",
    "start:server": "node scripts/start-production.js",
    "build:app": "cross-env NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "build:icons": "node scripts/build-icons.mjs",
    "build:components": "node scripts/bump-components.js && tsup",
    "build:tracker": "npm-run-all check:tracker build:tracker:script build:tracker:types",
    "build:tracker:script": "rollup -c rollup.tracker.config.js",
    "build:tracker:types": "node scripts/typecheck.mjs -p tsconfig.tracker.types.json && biome format --write src/tracker/index.d.ts",
    "check:tracker": "node scripts/typecheck.mjs -p tsconfig.tracker.json --noEmit",
    "build:recorder": "rollup -c rollup.recorder.config.js",
    "build:prisma:client": "node scripts/build-prisma-client.js",
    "build:languages": "npm-run-all download:countries download:languages",
    "build:geo": "node scripts/build-geo.js",
    "test:geo": "node --test scripts/test-build-geo.mjs",
    "test:name-data": "node --test scripts/test-download-name-data.mjs",
    "build:openapi": "npm-run-all openapi:generate generate:api:client",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build:db": "npm-run-all generate:db:client build:prisma:client",
    "db:pull": "prisma db pull",
    "generate:db:client": "prisma generate",
    "update:tracker": "node scripts/update-tracker.js",
    "db:migrate": "node scripts/check-db.js --migrate-only",
    "check:db": "node scripts/check-db.js",
    "check:db:build": "node scripts/check-build-db.js",
    "check:env": "node scripts/check-env.js",
    "check:migration-history": "node scripts/migration-ledger-contract.mjs",
    "check:messages": "node scripts/check-missing-messages.js",
    "check:native-bindings": "node scripts/check-native-bindings.js",
    "check:peers": "pnpm peers check",
    "copy-db-files": "node scripts/copy-db-files.js",
    "download:countries": "node scripts/download-country-names.js",
    "download:languages": "node scripts/download-language-names.js",
    "change-password": "node scripts/change-password.js",
    "openapi:generate": "node --import tsx scripts/generate-openapi.ts",
    "openapi:contracts": "node --import tsx scripts/generate-openapi-contracts.ts",
    "openapi:check": "node --import tsx scripts/check-openapi.ts",
    "generate:api": "npm-run-all openapi:generate generate:api:client",
    "generate:api:client": "node --import tsx scripts/generate-api-client.ts",
    "check:api:client": "node --import tsx scripts/generate-api-client.ts --check",
    "postbuild": "node scripts/postbuild.js",
    "runtime:manifest": "node scripts/runtime-artifact.mjs create .next/standalone",
    "runtime:verify": "node scripts/runtime-artifact.mjs verify .next/standalone",
    "test:runtime-artifact": "node --test scripts/test-runtime-artifact-manifest.mjs && node scripts/test-runtime-artifact.mjs",
    "test:artifact-integration": "node --test scripts/artifact-integration/contract.test.mjs",
    "test:replay-browser": "node --import tsx --test scripts/test-replay-resources-browser.mjs",
    "test:migration-bridge": "node scripts/test-session-data-migration-bridge.js",
    "test:migration-history": "node --test scripts/test-migration-ledger-contract.mjs scripts/test-applied-migrations.mjs",
    "test:database-host-policy": "node --test scripts/test-database-host-policy.mjs",
    "test:collection-key-config": "node --test scripts/test-collection-key-config.mjs",
    "test:service-identity": "node --test scripts/test-service-identity.mjs",
    "test:legacy-clickhouse-inventory": "node --test scripts/test-legacy-clickhouse-tables.mjs",
    "pretest": "pnpm generate:db:client",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:collection-rate-limit": "node --import tsx scripts/test-collection-rate-limit.ts",
    "test:packages": "pnpm --filter \"./packages/**\" -r test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api": "node --import tsx scripts/test-api.ts",
    "test:api:clickhouse": "node --import tsx scripts/test-api.ts --clickhouse",
    "test:api:run": "playwright test -c playwright.api.config.ts",
    "test:api:up": "node --import tsx scripts/test-api.ts --up-only",
    "test:api:down": "node --import tsx scripts/test-api.ts --down",
    "test:api:coverage": "node --import tsx scripts/test-api.ts --coverage-report",
    "db:seed": "node --import tsx scripts/seed-data.ts",
    "start-env": "pnpm run start:env",
    "start-server": "pnpm run start:server",
    "build-app": "pnpm run build:app",
    "build-icons": "pnpm run build:icons",
    "build-components": "pnpm run build:components",
    "build-tracker": "pnpm run build:tracker",
    "build-recorder": "pnpm run build:recorder",
    "build-prisma-client": "pnpm run build:prisma:client",
    "build-lang": "pnpm run build:languages",
    "build-geo": "pnpm run build:geo",
    "build-db": "pnpm run build:db",
    "build-db-schema": "pnpm run db:pull",
    "build-db-client": "pnpm run generate:db:client",
    "update-tracker": "pnpm run update:tracker",
    "update-db": "pnpm run db:migrate",
    "check-db": "pnpm run check:db",
    "check-env": "pnpm run check:env",
    "check-missing-messages": "pnpm run check:messages",
    "download-country-names": "pnpm run download:countries",
    "download-language-names": "pnpm run download:languages",
    "seed-data": "pnpm run db:seed",
    "lint": "biome lint .",
    "format:check": "biome check .",
    "typecheck": "node scripts/typecheck.mjs --noEmit",
    "audit:all": "pnpm audit --audit-level low",
    "audit:prod": "pnpm audit --prod --audit-level low",
    "prevalidate": "npm-run-all build:db build:packages",
    "validate": "npm-run-all check:migration-history test:migration-history test:database-host-policy test:collection-key-config test:service-identity test:legacy-clickhouse-inventory test:packaging test:typescript-entrypoints test:component-dependencies test:development-launcher test:collect-build-config test:geo test:name-data test:braces test:build-tool-vendors test:selector-parser test:source-map check:native-bindings check:peers format:check typecheck test:unit",
    "test:collect-build-config": "node --test scripts/test-collect-build-config.mjs",
    "format": "biome format --write .",
    "check": "biome check .",
    "test:migration-attempts": "node scripts/test-migration-attempt-paths.mjs",
    "test:postgres17-restore": "bash scripts/test-postgres17-restore.sh",
    "test:packaging": "node --test scripts/test-runtime-artifact-manifest.mjs scripts/test-runtime-workspaces.mjs scripts/test-mac-artifact-transport.mjs scripts/test-trusted-analytics-signer.mjs scripts/test-mac-build-cache-key.mjs deploy/mac-build/test-builder-boundary.mjs deploy/mac-build/test-cache-disposition.mjs deploy/mac-build/test-toolchain-fingerprint.mjs deploy/mac-build/test-verify-unsigned-assets.mjs deploy/mac-build/test-verify-vm-mounts.mjs scripts/test-prune-foreign-runtime-packages.mjs scripts/test-portable-pnpm-links.mjs",
    "test:braces": "node --test scripts/test-braces-compat.mjs",
    "test:build-tool-vendors": "node --test scripts/test-build-tool-vendors.mjs",
    "test:selector-parser": "node --test scripts/test-selector-parser-compat.mjs",
    "test:source-map": "node --test scripts/test-source-map-js-compat.mjs",
    "test:typescript-entrypoints": "node --test scripts/test-typescript-entrypoints.mjs scripts/test-typecheck.mjs",
    "test:component-dependencies": "node --test scripts/test-component-dependencies.mjs",
    "test:development-launcher": "node --test scripts/test-development-launcher.mjs"
  },
  "cacheDirectories": [
    ".next/cache"
  ],
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@date-fns/utc": "^2.1.1",
    "@dicebear/collection": "^9.4.3",
    "@dicebear/core": "^9.4.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@tanstack/react-query": "^5.105.3",
    "@umami/api-client": "workspace:*",
    "@umami/mcp": "workspace:*",
    "@umami/react-zen": "^0.255.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.1",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "classnames": "^2.5.1",
    "colord": "^2.10.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "debug": "^4.4.3",
    "detect-browser": "^5.3.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "immer": "^11.2.9",
    "ipaddr.js": "^2.5.0",
    "is-localhost-ip": "^3.0.1",
    "isbot": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "kafkajs": "^2.2.4",
    "lightningcss": "1.33.0",
    "lucide-react": "^1.67.0",
    "maxmind": "^5.0.8",
    "motion": "^14.9.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "npm-run-all2": "^9.0.4",
    "otplib": "^13.6.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-resizable-panels": "^4.17.0",
    "react-simple-maps": "^5.0.5",
    "react-use-measure": "^2.1.7",
    "react-window": "^2.5.3",
    "redis": "^6.3.1",
    "request-ip": "^3.3.0",
    "rrweb": "^2.2.0",
    "rrweb-player": "2.2.0",
    "semver": "^7.8.6",
    "server-only": "0.0.1",
    "thenby": "^1.4.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "zod": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@netlify/plugin-nextjs": "^5.16.6",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "11.6.2",
    "prompts": "2.4.2",
    "rollup": "^4.67.4",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-node-externals": "^9.0.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tar": "7.5.22",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "~5.1.0",
    "zod-openapi": "^6.0.2"
  }
}
