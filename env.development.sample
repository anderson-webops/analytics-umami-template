# Copy this file to .env for local development only. Leave PUBLIC_URL blank so
# same-origin checks use the actual localhost origin. Never deploy this file as
# production configuration.

# Supply a local PostgreSQL database and development-only secret before running
# the application. Do not reuse either value in production.
DATABASE_URL=
DATABASE_TYPE=postgresql
APP_SECRET=
PUBLIC_URL=
CLIENT_IP_HEADER=
INTERNAL_DIAGNOSTICS_KEY=
UMAMI_BIND_ADDRESS=127.0.0.1
PORT=3000

# Local development defaults. Production uses the hardened values in
# env.sample and requires an exact HTTPS PUBLIC_URL.
DISABLE_TELEMETRY=1
DISABLE_PUBLIC_SHARES=1
ENABLE_UPDATE_CHECKS=0
ENABLE_TEST_CONSOLE=0
FORCE_SSL=0
LOG_QUERY=0
SKIP_DB_CHECK=0
SKIP_DB_MIGRATION=0
TRUST_CLIENT_INFO_PAYLOAD=0
CLIENT_INFO_TRUST_KEY=
TRUST_LOCATION_HEADERS=0
SKIP_LOCATION_HEADERS=0
MCP_ENABLED=0

# Optional security and capacity controls (shown with application defaults).
AUTH_SESSION_TTL_SECONDS=28800
CACHE_TOKEN_TTL_SECONDS=86400
SHARE_TOKEN_TTL_SECONDS=3600
MAX_API_BODY_BYTES=1048576
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT_FAILURES=10
LOGIN_RATE_LIMIT_IP_FAILURES=50
COLLECTION_RATE_LIMIT_WINDOW_SECONDS=60
COLLECTION_RATE_LIMIT_PER_IP=1200
COLLECTION_RATE_LIMIT_PER_SOURCE=50000
SALT_ROTATION=month

# Optional services. Public hosts must use encrypted protocols.
# DIRECT_DATABASE_URL=
# DATABASE_REPLICA_URL=
# REDIS_URL=
# CLICKHOUSE_URL=
# KAFKA_URL=
# KAFKA_BROKER=
# KAFKA_SSL=1
# KAFKA_SASL_MECHANISM=scram-sha-512

# Optional UI/build configuration.
# ALLOWED_FRAME_URLS=
# API_URL=
# BASE_PATH=
# COLLECT_API_ENDPOINT=
# FAVICON_URL=
# LINKS_URL=
# PIXELS_URL=
# TRACKER_SCRIPT_NAME=
# TRACKER_SCRIPT_URL=
# UMAMI_SELF_TRACK=
# UMAMI_SELF_RECORD=

# Cypress integration tests read these from ../.env.
CYPRESS_umami_user=admin
CYPRESS_umami_password=
