# Copy this file to .env, restrict it to the current user, and replace every
# blank value. Never commit .env.

# The bundled database hostname is "db". URL-encode any reserved characters in
# POSTGRES_PASSWORD when placing the same password in DATABASE_URL.
# Example:
# postgresql://umami:URL_ENCODED_PASSWORD@db:5432/umami
DATABASE_URL=
DATABASE_TYPE=postgresql

# Generate independent values with: openssl rand -hex 32
APP_SECRET=
INTERNAL_DIAGNOSTICS_KEY=

# The public HTTPS origin and the one client-IP header that a trusted reverse
# proxy overwrites on every request.
PUBLIC_URL=
CLIENT_IP_HEADER=

# Bundled PostgreSQL values. Use a password of at least 16 random UTF-8 bytes.
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=

# Secure defaults.
DISABLE_TELEMETRY=1
DISABLE_PUBLIC_SHARES=1
ENABLE_UPDATE_CHECKS=0
ENABLE_TEST_CONSOLE=0
FORCE_SSL=1
LOG_QUERY=0
SKIP_DB_CHECK=0
SKIP_DB_MIGRATION=0
TRUST_CLIENT_INFO_PAYLOAD=0
CLIENT_INFO_TRUST_KEY=
TRUST_LOCATION_HEADERS=0
SKIP_LOCATION_HEADERS=0

# Security and capacity controls.
AUTH_SESSION_TTL_SECONDS=28800
CACHE_TOKEN_TTL_SECONDS=86400
SHARE_TOKEN_TTL_SECONDS=3600
MAX_API_BODY_BYTES=1048576
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT_FAILURES=10
LOGIN_RATE_LIMIT_IP_FAILURES=50
COLLECTION_RATE_LIMIT_WINDOW_SECONDS=60
COLLECTION_RATE_LIMIT_PER_IP=1200
COLLECTION_RATE_LIMIT_PER_SOURCE=50000
SALT_ROTATION=month

# Optional configuration.
# DIRECT_DATABASE_URL=
# DATABASE_REPLICA_URL=
# REDIS_URL=
# CLICKHOUSE_URL=
# KAFKA_URL=
# KAFKA_BROKER=
# KAFKA_SSL=1
# KAFKA_SASL_MECHANISM=scram-sha-512
# ALLOWED_FRAME_URLS=
# API_URL=
# BASE_PATH=
# COLLECT_API_ENDPOINT=
# FAVICON_URL=
# LINKS_URL=
# PIXELS_URL=
# TRACKER_SCRIPT_NAME=
# TRACKER_SCRIPT_URL=
# UMAMI_SELF_TRACK=
# UMAMI_SELF_RECORD=
