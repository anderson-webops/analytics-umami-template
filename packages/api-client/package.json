{
  "name": "@umami/api-client",
  "version": "0.81.0",
  "description": "TypeScript client for the Umami API, generated from the Umami OpenAPI contract.",
  "author": "Umami Software, Inc. <hello@umami.is>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "~5.1.0"
  }
}
